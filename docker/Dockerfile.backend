# syntax=docker/dockerfile:1.7

# ============================================
# mini-baas — Production Engine
# ============================================
# Stage 1: install dependencies with reusable cache mounts
# Stage 2: build NestJS output
# Stage 3: copy only runtime artifacts into the final image
# ============================================

ARG NODE_VERSION=22-alpine
ARG PNPM_VERSION=9

FROM node:${NODE_VERSION} AS build-base

WORKDIR /app

ENV PNPM_HOME="/pnpm" \
    PNPM_STORE_DIR="/pnpm/store" \
    PATH="/pnpm:$PATH"

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

FROM build-base AS deps

# Install build dependencies for native addons (bcrypt, better-sqlite3)
RUN --mount=type=cache,target=/var/cache/apk \
    apk add --update --no-progress python3 g++ make openssl libc6-compat

COPY app/package.json app/pnpm-lock.yaml* ./

RUN --mount=type=cache,id=mini-baas-pnpm-store,target=/pnpm/store \
    --mount=type=cache,id=mini-baas-node-gyp,target=/root/.cache/node-gyp \
    pnpm fetch --frozen-lockfile

RUN --mount=type=cache,id=mini-baas-pnpm-store,target=/pnpm/store \
    --mount=type=cache,id=mini-baas-node-gyp,target=/root/.cache/node-gyp \
    pnpm install --frozen-lockfile --offline

FROM deps AS build

COPY app/ ./

RUN pnpm run build && pnpm prune --prod

FROM node:${NODE_VERSION} AS production

WORKDIR /app

RUN --mount=type=cache,target=/var/cache/apk \
    apk add --update --no-progress dumb-init ca-certificates openssl libc6-compat

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nestjs -u 1001 && \
    mkdir -p /app/uploads && \
    chown -R nestjs:nodejs /app

COPY --from=build --chown=nestjs:nodejs /app/dist ./dist
COPY --from=build --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=build --chown=nestjs:nodejs /app/package.json ./package.json

USER nestjs

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
    CMD node -e "fetch('http://localhost:3000/health').then(r=>{process.exit(r.ok?0:1)}).catch(()=>process.exit(1))" || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]
